// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  
}
model Empresa {
  id        Int       @id @default(autoincrement()) 
  nome      String
  email     String    @unique
  senha     String
  telefone  String   
  endereco  String
  createdAt DateTime  @default(now())
  
  insumos   Insumo[]
  produtos  Produto[]

  clientes Cliente[]
  whatsappBusiness BusinessWhatsapp?
  pedidos Pedido[]
}

model Insumo {
  id              Int             @id @default(autoincrement())
  empresaId       Int
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  nome            String
  unidadeMedida   String          // 'kg', 'g', 'unidade', 'ml', 'l'
  quantidadeAtual Float
  estoqueMinimo   Float

  receitas        ProdutoInsumo[]
}

model Produto {
  id          Int             @id @default(autoincrement())
  empresaId   Int
  
  nome        String
  descricao   String?
  preco       Float
  categoria   String          // 'pizza', 'bebida', 'sobremesa', 'borda'
  disponivel  Boolean         @default(true)
  
  ingredientes  ProdutoInsumo[]
  @@unique([empresaId, nome])
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model ProdutoInsumo {
  id              Int     @id @default(autoincrement())
  produtoId       Int
  produto         Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  
  insumoId        Int
  insumo          Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  
  quantidadeGasta Float   
}
model Cliente {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  telefone     String
  nome         String
  endereco     String
  
  pedidos      Pedido[] // Um cliente possui vários pedidos ao longo do tempo

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([empresaId, telefone]) // Garante que o mesmo telefone não se repete para a mesma empresa
}

model Pedido {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  clienteId    Int
  cliente      Cliente  @relation(fields: [clienteId], references: [id])

  status       String   @default("espera") // 'espera', 'preparando', 'saiu para entrega', 'concluido'
  pedido       Json     // Armazena o array com os itens do pedido
  observacoes  String?
  valorTotal   Float    @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
model BusinessWhatsapp {
  id              Int      @id @default(autoincrement())
  empresaId       Int      @unique @map("empresa_id")
  phoneNumberId   String   @unique @map("phone_number_id")
  wabaId          String   @map("waba_id")
  accessToken     String   @map("access_token")
  verifyToken     String?  @map("verify_token")
  status          String   @default("ativo")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("business_whatsapp")
}